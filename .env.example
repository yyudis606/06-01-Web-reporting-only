# CONTOH ENV VARIABLE UNTUK SUPERTOKENS
# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.

# Alamat website (harus sama dengan domain deploy production nantinya)
NEXT_PUBLIC_API_DOMAIN=http://localhost:3000
NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3000

# Alamat SuperTokens Core (Managed Service dari supertokens.com).
# Ambil dari dashboard supertokens.com setelah membuat project.
SUPERTOKENS_CONNECTION_URI=https://xxxxxxxx.aws.supertokens.io

# Isi dengan API Key dari dashboard SuperTokens Managed Service.
SUPERTOKENS_API_KEY=
API_KEYS=

# Railway Project Token: dipakai untuk menampilkan kapasitas & pemakaian
# volume database Postgres yang akurat di panel admin (bagian Cloud Storage).
# Buat lewat Railway Dashboard > Project Settings > Tokens > New Token,
# pilih environment yang sesuai (mis. production). Optional - kalau kosong,
# panel admin akan pakai estimasi dari query SQL sebagai fallback.
RAILWAY_PROJECT_TOKEN=
RAILWAY_PROJECT_ID=
